# ==========================================
# KUBER FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public Configuration (Safe to expose on the client-side)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Flask Backend API URL (Default local development port: 5000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Map Provider Selection:
# - "osm" (Default: OpenStreetMap with Leaflet, 100% free, zero keys, zero credit card)
# - "mapbox" (Optional: Requires NEXT_PUBLIC_MAPBOX_TOKEN)
NEXT_PUBLIC_MAP_PROVIDER=osm

# Optional: Mapbox Public Token (Only needed if NEXT_PUBLIC_MAP_PROVIDER=mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=

