# ==========================================
# KUBER BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Flask App Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=kuber-dev-secret-key-replace-with-random-32-chars

# Allowed Frontend Origins (comma-separated for CORS)
CORS_ORIGINS=http://localhost:3000

# Supabase Server-Side Configuration (PRIVILEGED - NEVER EXPOSE TO FRONTEND)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional: PostgreSQL Direct Connection String (Settings -> Database -> Connection String)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# Simulation & Pricing Constants
ENABLE_DEMO_SIMULATION=true
BASE_FARE=50.0
PER_KM_RATE=12.0
PER_MINUTE_RATE=2.0

